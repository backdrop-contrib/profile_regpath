<?php
/**
 * @file
 * Contains ProfileRegpathAccessTest.
 */

/**
 * Basic tests.
 */
class ProfileRegpathAccessTest extends BackdropWebTestCase {

  /**
   * {@inheritdoc}
   */
  public function setUp() {
    $modules[] = 'profile';
    $modules[] = 'profile_regpath';
    parent::setUp($modules);

    // Set up a profile.
    $profile_type = new Profile(array(
      'type' => 'registration_path',
      'label' => 'Registration Path',
      'storage' => PROFILE_STORAGE_DEFAULT,
    ));
    profile_type_save($profile_type);

    // Configure a registration path.
    $profile_id = profile_regpath_get_profile_id($profile_type->type);
    $fields = array(
      'profile_type' => $profile_type->type,
      'path' => 'reg-path',
      'status' => 1,
      'weight' => 0,
      'roles' => serialize(array()),
      'misc' => serialize(array(
        'fieldset_wrap' => 0,
        'custom_titles' => 0,
        'login_title' => 'User Account',
        'register_title' => 'User Account',
        'password_title' => 'User Account',
        'confirmation_display' => 0,
        'confirmation_message' => '',
      )),
    );
    db_merge('profile_regpath')->key(array('profile_id' => $profile_id))->fields($fields)->execute();
    return TRUE;
  }

  /**
   * Test access to core and profile_regpath registration pages.
   */
  public function testAccess() {
    // Test the option to allow users to create their own accounts.
    config_set('system.core', 'user_register', USER_REGISTER_VISITORS);
    $this->resetAll();
    $this->backdropGet('user');
    $this->assertResponse(200);
    $this->backdropGet('user/login');
    $this->assertResponse(200);
    $this->backdropGet('user/password');
    $this->assertResponse(200);
    $this->backdropGet('user/register');
    $this->assertResponse(200);
    $this->backdropGet('reg-path');
    $this->assertResponse(200);
    $this->backdropGet('reg-path/login');
    $this->assertResponse(200);
    $this->backdropGet('reg-path/password');
    $this->assertResponse(200);
    $this->backdropGet('reg-path/register');
    $this->assertResponse(200);

    // Test the option where admin approval is required for account creation.
    config_set('system.core', 'user_register', USER_REGISTER_VISITORS_ADMINISTRATIVE_APPROVAL);
    $this->resetAll();
    $this->backdropGet('user');
    $this->assertResponse(200);
    $this->backdropGet('user/login');
    $this->assertResponse(200);
    $this->backdropGet('user/password');
    $this->assertResponse(200);
    $this->backdropGet('user/register');
    $this->assertResponse(200);
    $this->backdropGet('reg-path');
    $this->assertResponse(200);
    $this->backdropGet('reg-path/login');
    $this->assertResponse(200);
    $this->backdropGet('reg-path/password');
    $this->assertResponse(200);
    $this->backdropGet('reg-path/register');
    $this->assertResponse(200);

    // Test the option where only admins may create accounts.
    config_set('system.core', 'user_register', USER_REGISTER_ADMINISTRATORS_ONLY);
    $this->resetAll();
    $this->backdropGet('user');
    $this->assertResponse(200);
    $this->backdropGet('user/login');
    $this->assertResponse(200);
    $this->backdropGet('user/password');
    $this->assertResponse(200);
    $this->backdropGet('user/register');
    $this->assertResponse(403);
    $this->backdropGet('reg-path');
    $this->assertResponse(200);
    $this->backdropGet('reg-path/login');
    $this->assertResponse(200);
    $this->backdropGet('reg-path/password');
    $this->assertResponse(200);
    $this->backdropGet('reg-path/register');
    $this->assertResponse(403);
  }

}
